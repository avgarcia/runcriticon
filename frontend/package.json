{
  "name": "runcriticon-frontend",
  "version": "0.0.1",
  "description": "Frontend Angular de Runcriticon (ADR-0012)",
  "private": true,
  "scripts": {
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "jest",
    "test:watch": "jest --watch",
    "e2e": "playwright test",
    "lint": "ng lint",
    "format": "prettier --write \"src/**/*.{ts,html,scss,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss,json}\"",
    "gen:api": "ng-openapi-gen --config ng-openapi-gen.json"
  },
  "dependencies": {
    "@angular/cdk": "^22.0.6",
    "@angular/common": "^22.0.8",
    "@angular/compiler": "^22.0.8",
    "@angular/core": "^22.0.8",
    "@angular/forms": "^22.0.8",
    "@angular/localize": "^22.0.8",
    "@angular/platform-browser": "^22.0.8",
    "@angular/router": "^22.0.8",
    "@ng-icons/core": "^33.3.0",
    "@ng-icons/lucide": "^33.3.0",

    "@spartan-ng/brain": "^1.1.2",
    "@zxcvbn-ts/core": "^4.1.2",
    "@zxcvbn-ts/language-common": "^4.1.2",
    "@zxcvbn-ts/language-es-es": "^4.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ngx-sonner": "^3.1.0",
    "rxjs": "~7.8.0",
    "tailwind-merge": "^3.6.0",
    "tslib": "^2.8.0",
    "tw-animate-css": "^1.4.0",
    "zone.js": "~0.16.2"
  },
  "devDependencies": {
    "@angular/build": "^22.0.8",
    "@angular/cli": "^22.0.8",
    "@angular/compiler-cli": "^22.0.2",
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.61.1",
    "@spartan-ng/cli": "^1.1.0",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/jest": "^30.0.0",
    "angular-eslint": "^22.0.0",
    "eslint": "^10.6.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.0.0",
    "jest-preset-angular": "^17.0.0",
    "ng-openapi-gen": "^1.0.5",
    "postcss": "^8.5.16",
    "prettier": "^3.9.5",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.62.1"
  }
}
