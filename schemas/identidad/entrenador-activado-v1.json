{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://runcriticon.com/schemas/identidad/entrenador-activado-v1.json",
  "title": "EntrenadorActivado",
  "description": "Un entrenador ha activado su cuenta por invitación (pasa a ACTIVO) en el club (módulo identidad, LAL-9).",
  "type": "object",
  "required": ["eventId", "aggregateId", "occurredAt", "version", "clubId", "name", "email"],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "aggregateId": { "type": "string", "format": "uuid", "description": "userId del entrenador activado" },
    "occurredAt": { "type": "string", "format": "date-time" },
    "version": { "type": "integer", "minimum": 1 },
    "clubId": { "type": "string", "format": "uuid" },
    "actorId": { "type": ["string", "null"], "format": "uuid" },
    "traceparent": { "type": ["string", "null"] },
    "name": { "type": "string" },
    "email": { "type": "string", "format": "email" }
  },
  "additionalProperties": false
}
