{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://runcriticon.com/schemas/planificacion/personalizacion-retirada-v1.json",
  "title": "PersonalizacionRetirada",
  "description": "El entrenador retiró la personalización de un alumno en una sesión, con el plan ya PUBLICADO (módulo planificacion, LAL-26). `aggregateId` es el plan. Lleva la sesión base embebida (`baseSession`) para que el consumidor pueda restaurarla sin preguntarle nada a planificacion (ADR-0007, prohibido cruzar módulo con llamada síncrona).",
  "type": "object",
  "required": ["eventId", "aggregateId", "occurredAt", "version", "clubId", "grupoId", "sesionId", "dia", "alumnoId", "baseSession"],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "aggregateId": { "type": "string", "format": "uuid", "description": "Id del plan semanal" },
    "occurredAt": { "type": "string", "format": "date-time" },
    "version": { "type": "integer", "minimum": 1 },
    "clubId": { "type": "string", "format": "uuid" },
    "actorId": { "type": ["string", "null"], "format": "uuid" },
    "traceparent": { "type": ["string", "null"] },
    "grupoId": { "type": "string", "format": "uuid" },
    "sesionId": { "type": "string", "format": "uuid" },
    "dia": { "type": "string", "format": "date" },
    "alumnoId": { "type": "string", "format": "uuid" },
    "baseSession": {
      "type": "object",
      "required": ["tipo"],
      "properties": {
        "tipo": {
          "type": "string",
          "enum": ["RODAJE", "SERIES", "TEMPO", "TIRADA_LARGA", "FARTLEK", "CUESTAS", "PROGRESIVO", "FUERZA_CROSS", "COMPETICION", "DESCANSO"]
        },
        "volumenTipo": { "type": ["string", "null"], "enum": ["DISTANCIA", "TIEMPO", null] },
        "volumenMetros": { "type": ["integer", "null"] },
        "volumenMinutos": { "type": ["integer", "null"] },
        "ritmoTipo": { "type": ["string", "null"], "enum": ["ABSOLUTO", "RELATIVO", null] },
        "ritmoSegundosPorKm": { "type": ["integer", "null"] },
        "ritmoReferencia": { "type": ["string", "null"], "enum": ["5K", "10K", "21K", "42K", null] },
        "ritmoDeltaSegundosPorKm": { "type": ["integer", "null"] },
        "notas": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
