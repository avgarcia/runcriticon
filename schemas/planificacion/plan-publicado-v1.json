{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://runcriticon.com/schemas/planificacion/plan-publicado-v1.json",
  "title": "PlanPublicado",
  "description": "Un plan semanal se publicó a su grupo (módulo planificacion). Auto-contenido (ADR-0007 D15): lleva el snapshot completo de alumnos y las sesiones de la semana. `aggregateId` es el plan.",
  "type": "object",
  "required": ["eventId", "aggregateId", "occurredAt", "version", "clubId", "grupoId", "snapshotAlumnos", "sesiones"],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "aggregateId": { "type": "string", "format": "uuid", "description": "Id del plan semanal publicado" },
    "occurredAt": { "type": "string", "format": "date-time" },
    "version": { "type": "integer", "minimum": 1 },
    "clubId": { "type": "string", "format": "uuid" },
    "actorId": { "type": ["string", "null"], "format": "uuid" },
    "traceparent": { "type": ["string", "null"] },
    "grupoId": { "type": "string", "format": "uuid" },
    "snapshotAlumnos": {
      "type": "array",
      "description": "Snapshot completo: todos los alumnos que pertenecían al grupo justo antes de publicar.",
      "items": { "type": "string", "format": "uuid" }
    },
    "sesiones": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["dia", "tipo"],
        "properties": {
          "dia": { "type": "string", "format": "date" },
          "tipo": {
            "type": "string",
            "enum": ["RODAJE", "SERIES", "TEMPO", "TIRADA_LARGA", "FARTLEK", "CUESTAS", "PROGRESIVO", "FUERZA_CROSS", "COMPETICION", "DESCANSO"]
          },
          "volumenTipo": { "type": ["string", "null"], "enum": ["DISTANCIA", "TIEMPO", null] },
          "volumenMetros": { "type": ["integer", "null"] },
          "volumenMinutos": { "type": ["integer", "null"] },
          "ritmoTipo": { "type": ["string", "null"], "enum": ["ABSOLUTO", "RELATIVO", null] },
          "ritmoSegundosPorKm": { "type": ["integer", "null"] },
          "ritmoReferencia": { "type": ["string", "null"], "enum": ["5K", "10K", "21K", "42K", null] },
          "ritmoDeltaSegundosPorKm": { "type": ["integer", "null"] },
          "notas": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    },
    "personalizaciones": {
      "type": "array",
      "description": "Personalizaciones creadas antes de publicar (LAL-26, AC2): no emitieron PersonalizacionAplicada propio porque todavía no había snapshot al que proyectar. Campo aditivo, ausente o vacío en un evento de una versión anterior a LAL-26.",
      "items": {
        "type": "object",
        "required": ["sesionId", "dia", "alumnoId", "override"],
        "properties": {
          "sesionId": { "type": "string", "format": "uuid" },
          "dia": { "type": "string", "format": "date" },
          "alumnoId": { "type": "string", "format": "uuid" },
          "override": {
            "type": "object",
            "required": ["tipo"],
            "properties": {
              "tipo": {
                "type": "string",
                "enum": ["RODAJE", "SERIES", "TEMPO", "TIRADA_LARGA", "FARTLEK", "CUESTAS", "PROGRESIVO", "FUERZA_CROSS", "COMPETICION", "DESCANSO"]
              },
              "volumenTipo": { "type": ["string", "null"], "enum": ["DISTANCIA", "TIEMPO", null] },
              "volumenMetros": { "type": ["integer", "null"] },
              "volumenMinutos": { "type": ["integer", "null"] },
              "ritmoTipo": { "type": ["string", "null"], "enum": ["ABSOLUTO", "RELATIVO", null] },
              "ritmoSegundosPorKm": { "type": ["integer", "null"] },
              "ritmoReferencia": { "type": ["string", "null"], "enum": ["5K", "10K", "21K", "42K", null] },
              "ritmoDeltaSegundosPorKm": { "type": ["integer", "null"] },
              "notas": { "type": ["string", "null"] }
            },
            "additionalProperties": false
          },
          "mensajeAlAlumno": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
